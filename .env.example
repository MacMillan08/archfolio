NODE_ENV=production
PORT=3000

# Neon (pooled) baglanti dizesi
DATABASE_URL=
# Opsiyonel: migration icin Neon'un pooler'siz (direct) baglanti dizesi
DIRECT_URL=

# Canli domain — Open Graph/Twitter onizleme etiketlerindeki mutlak adresler icin.
# Bos birakilirsa http://localhost:PORT kullanilir. Sonunda / olmadan, ornek:
# https://archfolio.onrender.com
SITE_URL=

ADMIN_USER=
# Production'da en az 12 karakter
ADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opsiyonel — cold start'i onlemek icin kendi kendini pingleme (10 dk'da bir).
# Bos birakilirsa zamanlayici hic baslamaz. Deger, sitenin kendi adresi + /health
# olmali, ornek: https://archfolio.onrender.com/health
SELF_PING_URL=
