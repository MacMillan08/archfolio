<%- include('partials/header', { title: project.title }) %>

<main>
  <article class="project-detail">
    <div class="zoom-media detail-hero">
      <img src="<%= project.imageUrl %>" alt="<%= project.title %>">
    </div>
    <div class="detail-body">
      <p class="eyebrow"><%= project.category %></p>
      <h1><%= project.title %></h1>
      <p class="detail-desc"><%= project.description %></p>
      <p class="detail-date"><%= new Date(project.createdAt).toLocaleDateString('tr-TR', { year: 'numeric', month: 'long' }) %></p>
      <a class="btn btn-ghost" href="/#projeler">← Tüm projeler</a>
    </div>
  </article>
</main>

<%- include('partials/footer') %>
