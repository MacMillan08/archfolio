<%- include('header', { title: 'Hakkımda', active: 'about' }) %>

<section class="page-head">
  <div>
    <p class="kicker">Profil</p>
    <h1>Hakkımda</h1>
  </div>
</section>

<% if (error) { %><p class="alert"><%= error %></p><% } %>

<form class="glass form-panel" method="post" action="/admin/about" enctype="multipart/form-data">
  <div class="form-fields">
    <label class="field">
      <span>Biyografi</span>
      <textarea name="bio" rows="9"><%= about ? about.bio || '' : '' %></textarea>
    </label>
    <label class="field">
      <span>Profil Fotoğrafı</span>
      <input type="file" name="profileImage" accept="image/*">
    </label>
  </div>

  <% if (about && about.profileImage) { %>
    <div class="form-preview" id="aboutPhotoPreview">
      <span class="field-label">Mevcut Fotoğraf</span>
      <img class="preview" src="<%= about.profileImage %>" alt="Mevcut profil fotoğrafı">
      <%# type="button": bu, dışarıdaki form'u asla submit etmez, required doğrulamasını
          tetiklemez. Önceki sürümde burada form içinde ayrı bir <form> vardı — iç içe
          <form> geçersiz HTML olduğu için tarayıcı bunu dış forma birleştiriyor,
          tıklama dış formu (bio "required" dahil) gönderiyordu. %>
      <button type="button" class="btn btn-danger btn-sm" id="removeAboutPhotoBtn">Fotoğrafı Kaldır</button>
    </div>
  <% } %>

  <div class="form-actions">
    <button class="btn btn-primary" type="submit">Kaydet</button>
    <a class="btn btn-glass" href="/admin">Vazgeç</a>
  </div>
</form>

<script>
  // Fotoğraf kaldırma, formun geri kalanından tamamen bağımsız: sayfa yenilenmez,
  // bio veya diğer alanlardaki kaydedilmemiş yazı korunur. Sadece DELETE isteği atar.
  (function () {
    var btn = document.getElementById("removeAboutPhotoBtn");
    if (!btn) return;
    btn.addEventListener("click", function () {
      if (!window.confirm("Fotoğrafı kaldırmak istediğine emin misin?")) return;
      btn.disabled = true;
      fetch("/admin/about/photo", { method: "DELETE" })
        .then(function (res) {
          if (!res.ok) throw new Error("İstek başarısız (" + res.status + ")");
          var preview = document.getElementById("aboutPhotoPreview");
          if (preview) preview.remove();
        })
        .catch(function (err) {
          window.alert("Fotoğraf kaldırılamadı: " + err.message);
          btn.disabled = false;
        });
    });
  })();
</script>

<%- include('footer') %>
